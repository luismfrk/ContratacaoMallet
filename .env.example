# Nunca coloque chaves reais neste arquivo.
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=

# Use true quando o sistema estiver publicado exclusivamente em HTTPS.
COOKIE_SECURE=false

# SQLite local (padrão quando DATABASE_URL não for informada).
# Para MySQL, use uma conexão criada especificamente para o sistema:
# DATABASE_URL=mysql+pymysql://usuario:senha@servidor:3306/contratacoes?charset=utf8mb4
DATABASE_URL=
